# Neon connection string (Vercel's Neon integration sets this for you)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Public URL of the deployed site, used for metadata and by store:add to refresh the cache
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
# Any random string; protects /api/revalidate
REVALIDATE_SECRET=change-me
